<div class="flex-1 flex flex-col bg-white overflow-hidden">
  <% if book.nil? %>
    <div class="flex-1 flex flex-col items-center justify-center text-gray-400 bg-gray-50/50">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-4 opacity-20"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
      <p>Select a book to view details.</p>
    </div>
  <% else %>
    <div class="w-full max-w-xl mx-auto flex flex-col h-full">
      
      <!-- Detail Header -->
      <div class="px-8 pt-10 pb-6 bg-white shrink-0">
        <div class="flex justify-between items-start">
          <div>
             <h1 class="text-2xl font-semibold text-gray-900 mb-2"><%= book.title %></h1>
             <p class="text-gray-500 text-base"><%= book.author %></p>
             <p class="text-xs text-gray-400 mt-1 uppercase tracking-wider">ISBN: <%= book.isbn %></p>
          </div>
          <div class="flex gap-2">
            <%= button_to book_path(book), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "p-2 text-gray-400 hover:text-red-600 transition-colors" do %>
               <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Accessions List -->
      <div class="flex-1 overflow-y-auto px-8 py-6">
        <h3 class="text-xs font-semibold text-gray-900 uppercase tracking-wider mb-4">Accessions (<%= accessions.count %>)</h3>
        
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-[10px] font-medium text-gray-500 uppercase tracking-wider">Accession #</th>
                <th class="px-6 py-3 text-left text-[10px] font-medium text-gray-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% accessions.each do |acc| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= acc.accession_number %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <span class="px-2 py-0.5 inline-flex text-[10px] leading-4 font-semibold rounded-full bg-green-100 text-green-800 border border-green-200">
                      <%= acc.status.humanize %>
                    </span>
                  </td>
                </tr>
              <% end %>
              <% if accessions.empty? %>
                <tr>
                   <td colspan="2" class="px-6 py-8 text-center text-sm text-gray-500">No physical copies found.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
