<!-- Middle Column -->
<div class="w-96 flex-shrink-0 border-r border-gray-200 bg-white z-10 flex flex-col">
  <%= turbo_frame_tag "list_frame" do %>
    <%= render "form", book: @book, errors: defined?(@errors) ? @errors : nil %>
  <% end %>
</div>

<!-- Right Column - We stay in whatever state we were in, or empty if direct hit -->
<div class="flex-1 flex flex-col min-w-0 bg-white">
  <%= turbo_frame_tag "detail_frame" do %>
    <%= render "detail", book: nil, accessions: [] %>
  <% end %>
</div>
