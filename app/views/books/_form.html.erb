<div class="w-full h-full flex flex-col bg-white">
  <!-- Form Header matching List Header style -->
  <div class="h-16 px-6 border-b border-gray-200 flex items-center justify-between flex-shrink-0 bg-gray-50">
    <div class="flex items-center gap-2">
       <%= link_to root_path, data: { turbo_frame: "list_frame" }, class: "text-gray-500 hover:text-gray-900 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
       <% end %>
       <h2 class="font-semibold text-gray-900">New Entry</h2>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto p-6">
    <% if errors %>
      <div class="mb-6 p-4 bg-red-50 text-red-600 rounded-md border border-red-100 text-xs">
        <ul class="list-disc pl-4">
          <% errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div id="isbn-message" data-isbn-precheck-target="message" class="hidden mb-4 p-3 bg-blue-50 text-blue-700 rounded-md border border-blue-100 text-[10px] leading-tight font-medium">
    </div>

    <%= form_with model: book, url: books_path, class: "space-y-6", data: { controller: "isbn-precheck", turbo: true } do |f| %>
      <div class="space-y-1">
        <%= f.label :title, class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider" %>
        <%= f.text_field :title, placeholder: "Title", required: true, data: { isbn_precheck_target: "title" }, class: "w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-300 transition-colors" %>
      </div>

      <div class="space-y-1">
        <%= f.label :author, class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider" %>
        <%= f.text_field :author, placeholder: "Author", required: true, data: { isbn_precheck_target: "author" }, class: "w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-300 transition-colors" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-1">
          <%= f.label :isbn, "ISBN", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider" %>
          <%= f.text_field :isbn, placeholder: "ISBN", required: true, data: { action: "input->isbn-precheck#check", isbn_precheck_target: "isbn" }, class: "w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-300 transition-colors" %>
        </div>
        <div class="space-y-1">
          <%= f.label :accession_number, "Accession #", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider" %>
          <%= f.text_field :accession_number, placeholder: "Copy ID", required: true, class: "w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-300 transition-colors" %>
        </div>
      </div>

      <div class="pt-6">
        <%= f.submit "Add Book", class: "w-full py-2 bg-gray-900 text-white rounded font-medium text-sm hover:bg-gray-800 transition-colors cursor-pointer" %>
        <p class="mt-4 text-[10px] text-gray-400 text-center leading-tight px-2">
          Duplicate ISBNs will automatically append a new accession number.
        </p>
      </div>
    <% end %>
  </div>
</div>
